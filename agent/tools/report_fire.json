{
  "type": "webhook",
  "name": "report_fire",
  "description": "Create or update a fire report from landmark words. Never invent coordinates.",
  "api_schema": {
    "url": "{{PUBLIC_BASE_URL}}/api/tools/report_fire",
    "method": "POST",
    "request_headers": {
      "X-Agni-Tool-Secret": "{{ELEVENLABS_TOOL_SECRET}}",
      "Content-Type": "application/json"
    },
    "request_body_schema": {
      "type": "object",
      "properties": {
        "conversation_id": { "type": "string" },
        "landmark_text": { "type": "string" },
        "what_seen": { "type": "string" },
        "language": { "type": "string" }
      },
      "required": ["conversation_id", "landmark_text"]
    }
  }
}
