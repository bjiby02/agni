{
  "type": "webhook",
  "name": "add_bearing",
  "description": "Call when the caller says which way the smoke is.",
  "api_schema": {
    "url": "{{PUBLIC_BASE_URL}}/api/tools/add_bearing",
    "method": "POST",
    "request_headers": {
      "X-Agni-Tool-Secret": "{{ELEVENLABS_TOOL_SECRET}}",
      "Content-Type": "application/json"
    },
    "request_body_schema": {
      "type": "object",
      "required": ["conversation_id", "direction_words"],
      "properties": {
        "conversation_id": {
          "type": "string",
          "dynamic_variable": "system__conversation_id"
        },
        "direction_words": {
          "type": "string",
          "description": "Caller's words, e.g. 'northeast', 'inland', 'toward the ocean'"
        }
      }
    }
  }
}
