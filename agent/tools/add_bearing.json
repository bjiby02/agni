{
  "type": "webhook",
  "name": "add_bearing",
  "description": "Record a spoken or compass bearing toward smoke.",
  "api_schema": {
    "url": "{{PUBLIC_BASE_URL}}/api/tools/add_bearing",
    "method": "POST",
    "request_headers": {
      "X-Agni-Tool-Secret": "{{ELEVENLABS_TOOL_SECRET}}",
      "Content-Type": "application/json"
    },
    "request_body_schema": {
      "type": "object",
      "properties": {
        "conversation_id": { "type": "string" },
        "direction_words": { "type": "string" },
        "bearing_deg": { "type": "number" },
        "lat": { "type": "number" },
        "lon": { "type": "number" },
        "source": { "type": "string" }
      },
      "required": ["conversation_id"]
    }
  }
}
