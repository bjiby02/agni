{
  "type": "webhook",
  "name": "set_needs",
  "description": "Call when you learn who needs help.",
  "api_schema": {
    "url": "{{PUBLIC_BASE_URL}}/api/tools/set_needs",
    "method": "POST",
    "request_headers": {
      "X-Agni-Tool-Secret": "{{ELEVENLABS_TOOL_SECRET}}",
      "Content-Type": "application/json"
    },
    "request_body_schema": {
      "type": "object",
      "required": ["conversation_id"],
      "properties": {
        "conversation_id": {
          "type": "string",
          "dynamic_variable": "system__conversation_id"
        },
        "mobility": {
          "type": "boolean",
          "description": "Someone can't walk or needs help moving"
        },
        "people": {
          "type": "integer",
          "description": "Number of people with the caller"
        },
        "notes": {
          "type": "string",
          "description": "Short notes: kids, pets, oxygen"
        }
      }
    }
  }
}
